+def _compress_sf(self, st) -> None:
+    """Replace this layer's MegaMoE L1/L2 SF tensors by compressed slots plus the shared decode scratch."""
+    sfc = _sf_module()
+    csf = []
+    new = []
+    if _sf_check_left > 0 and st.idx in SF_CHECK_LAYERS:
+        st.sf_raw = (self._transformed_l1_weights[1], self._transformed_l2_weights[1])
+    for w, sf in (self._transformed_l1_weights, self._transformed_l2_weights):
+        c = sfc.encode(sf)
+        key = (tuple(sf.shape), tuple(sf.stride()), sf.device)
+        if key not in _sf_scratch:
+            _sf_scratch[key] = sfc.empty_like_sf(c.shape, c.stride, sf.device)
+        _sf_bytes[0] += sf.numel() * 4
+        _sf_bytes[1] += c.nbytes()
+        csf.append(c)
+        new.append((w, _sf_scratch[key]))
