+// 16 B store into this CTA's SMEM at `dst`, completing 16 tx bytes on the barrier `bar` of CTA `bar_cta` (same
+// offset in that CTA). The store and its complete_tx are asynchronous: no release by this thread, so outstanding
+// slot prefetches are not waited on.
+CUTLASS_DEVICE void st_async_tx(void* dst, uint4 v, const void* bar, uint32_t bar_cta, uint32_t own_cta) {
+    asm volatile("{\n\t.reg .b32 d, b;\n\t"
+                 "mapa.shared::cluster.u32 d, %0, %6;\n\t"
+                 "mapa.shared::cluster.u32 b, %1, %7;\n\t"
+                 "st.async.shared::cluster.mbarrier::complete_tx::bytes.v4.b32 [d], {%2, %3, %4, %5}, [b];\n\t}"
+                 :: "r"(smem_addr(dst)), "r"(smem_addr(bar)), "r"(v.x), "r"(v.y), "r"(v.z), "r"(v.w),
+                    "r"(own_cta), "r"(bar_cta) : "memory");
+}
+
+CUTLASS_DEVICE void arrive_expect_tx_relaxed(const void* bar, uint32_t tx) {
+    asm volatile("mbarrier.arrive.expect_tx.relaxed.cluster.shared::cta.b64 _, [%0], %1;"
+                 :: "r"(smem_addr(bar)), "r"(tx) : "memory");
+}
+
+CUTLASS_DEVICE void remote_arrive_relaxed(const void* bar, uint32_t cta_id) {
+    asm volatile("{\n\t.reg .b32 remAddr32;\n\t"
+                 "mapa.shared::cluster.u32 remAddr32, %0, %1;\n\t"
+                 "mbarrier.arrive.relaxed.cluster.shared::cluster.b64 _, [remAddr32];\n\t}"
+                 :: "r"(smem_addr(bar)), "r"(cta_id) : "memory");
+}
