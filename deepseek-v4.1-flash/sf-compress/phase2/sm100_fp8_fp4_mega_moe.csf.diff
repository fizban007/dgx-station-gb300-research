+// ---------------------------------------------------------------------------------------------------------------
+// Compressed weight scales (ds4-station csf-port phase 2). When the kernel is launched with a non-null
+// `cumulative_local_expert_recv_stats`, that pointer is reinterpreted as a table of four device pointers
+// {l1_slots, l1_overflow, l2_slots, l2_overflow} and the routed SFB tiles are decoded by the B producer warp
+// instead of being TMA-loaded. Each 512 B tile (expert e, k-block kb, 128-row n-block nb) is one 80 B slot of
+// 20 uint32 at slots + ((e * Kp + kb) * NB + nb) * 20:
+//   word 0      base (bits 0-7) | n_exc (bits 8-9) | spill (bit 10) | spill index (bits 11-31)
+//   words 1-16  one bit per scale: tile word w (4 K-group bytes) takes bits 4*(w%8).. of word 1 + w/8
+//   words 17-19 exceptions: byte position (bits 0-8) | value << 16
+// Spilled tiles are stored raw (128 uint32) at overflow + index * 128. The shared expert keeps TMA.
+// A null pointer (the stock vLLM call, e.g. the drafter) keeps the original code path. The original stats
+// accumulation is dropped (vLLM never passes it).
+namespace csf {
+
+CUTLASS_DEVICE uint32_t smem_addr(const void* p) {
+    return static_cast<uint32_t>(__cvta_generic_to_shared(p));
+}
+
+// Generic-proxy SMEM writes -> async proxy (tcgen05.cp) of this or the peer CTA.
+CUTLASS_DEVICE void fence_proxy_async() {
+    asm volatile("fence.proxy.async.shared::cta;" ::: "memory");
+}
+
+CUTLASS_DEVICE void arrive_expect_tx_release_cluster(const void* bar, uint32_t tx) {
+    asm volatile("mbarrier.arrive.expect_tx.release.cluster.shared::cta.b64 _, [%0], %1;"
+                 :: "r"(smem_addr(bar)), "r"(tx) : "memory");
+}
+
+CUTLASS_DEVICE void remote_arrive_release_cluster(const void* bar, uint32_t cta_id) {
+    asm volatile("{\n\t.reg .b32 remAddr32;\n\t"
+                 "mapa.shared::cluster.u32 remAddr32, %0, %1;\n\t"
+                 "mbarrier.arrive.release.cluster.shared::cluster.b64 _, [remAddr32];\n\t}"
+                 :: "r"(smem_addr(bar)), "r"(cta_id) : "memory");
+}
+
+CUTLASS_DEVICE void wait_acquire_cluster(const void* bar, uint32_t phase) {
+    asm volatile("{\n\t.reg .pred P1;\n\t"
+                 "LAB_WAIT:\n\t"
+                 "mbarrier.try_wait.parity.acquire.cluster.shared::cta.b64 P1, [%0], %1;\n\t"
+                 "@P1 bra DONE;\n\t"
+                 "bra LAB_WAIT;\n\t"
+                 "DONE:\n\t}"
+                 :: "r"(smem_addr(bar)), "r"(phase) : "memory");
+}
+
+// Lanes 0..19 load the 20 words of one slot (coalesced 80 B); other lanes return 0.
+CUTLASS_DEVICE uint32_t load_slot(const uint32_t* slots, uint64_t chunk, uint32_t lane) {
+    return lane < 20 ? __ldg(slots + chunk * 20 + lane) : 0u;
+}
+
+// Lane L returns tile words 4L..4L+3 (rows {L, 32+L, 64+L, 96+L} after the UTCCP permutation).
+CUTLASS_DEVICE uint4 decode_slot(uint32_t v, const uint32_t* overflow, uint32_t lane) {
+    const uint32_t hdr = __shfl_sync(0xffffffffu, v, 0);
+    const uint32_t plane = __shfl_sync(0xffffffffu, v, 1 + (lane >> 1));
+    const uint32_t e0 = __shfl_sync(0xffffffffu, v, 17);
+    const uint32_t e1 = __shfl_sync(0xffffffffu, v, 18);
+    const uint32_t e2 = __shfl_sync(0xffffffffu, v, 19);
+    if ((hdr >> 10) & 1u) {
+        const uint32_t si = hdr >> 11;
+        return __ldg(reinterpret_cast<const uint4*>(overflow) + static_cast<uint64_t>(si) * 32 + lane);
+    }
+    const uint32_t base = (hdr & 0xffu) * 0x01010101u;
+    const uint32_t bits = (plane >> ((lane & 1u) * 16)) & 0xffffu;
+    uint32_t w[4];
+    #pragma unroll
+    for (uint32_t i = 0; i < 4; ++ i)
+        w[i] = base + ((((bits >> (4 * i)) & 0xfu) * 0x00204081u) & 0x01010101u);
+    const uint32_t n_exc = (hdr >> 8) & 3u;
+    #pragma unroll
+    for (uint32_t j = 0; j < 3; ++ j) {
+        const uint32_t e = j == 0 ? e0 : (j == 1 ? e1 : e2);
+        const uint32_t pos = e & 0x1ffu;
+        if (j < n_exc and (pos >> 4) == lane) {
+            const uint32_t sh = (pos & 3u) * 8;
+            const uint32_t val = ((e >> 16) & 0xffu) << sh;
+            #pragma unroll
+            for (uint32_t i = 0; i < 4; ++ i)
+                if (((pos >> 2) & 3u) == i)
+                    w[i] = (w[i] & ~(0xffu << sh)) | val;
+        }
+    }
+    return make_uint4(w[0], w[1], w[2], w[3]);
+}
