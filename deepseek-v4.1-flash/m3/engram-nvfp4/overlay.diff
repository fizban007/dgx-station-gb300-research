+# Engram table row formats. "fp8" is the original checkpoint: e4m3 values with
+# one ue8m0 scale per 32. "nvfp4" (config ``engram_quant: "nvfp4"``) packs two
+# e2m1 values per byte (low nibble = even element), one e4m3 scale per 16 and
+# one fp32 global scale per table: value = e2m1 * e4m3_scale * global.
+ENGRAM_QUANT_FP8 = "fp8"
+ENGRAM_QUANT_NVFP4 = "nvfp4"
+FP8_SCALE_BLOCK = 32
+NVFP4_SCALE_BLOCK = 16
+
+
+def parse_engram_quant(
+    config, layer_ids: tuple[int, ...], head_dim: int
+) -> tuple[str, int, tuple[float, ...] | None]:
+    """Read the table format from the checkpoint config.
+
+    Returns (format, scale block size, per-table global scales or None).
+    Configs without ``engram_quant`` describe the original FP8 tables.
+    """
+    quant = getattr(config, "engram_quant", None)
+    if quant is None or str(quant).lower() == ENGRAM_QUANT_FP8:
+        return ENGRAM_QUANT_FP8, FP8_SCALE_BLOCK, None
+    quant = str(quant).lower()
+    if quant != ENGRAM_QUANT_NVFP4:
+        raise ValueError(
+            f"Unsupported engram_quant {quant!r}; expected "
+            f"{ENGRAM_QUANT_FP8!r} or {ENGRAM_QUANT_NVFP4!r}"
+        )
+    block = getattr(config, "engram_quant_block_size", None)
+    block = NVFP4_SCALE_BLOCK if block is None else int(block)
+    if block != NVFP4_SCALE_BLOCK or head_dim % NVFP4_SCALE_BLOCK:
+        raise ValueError(
+            f"NVFP4 engram tables need {NVFP4_SCALE_BLOCK}-element scale blocks "
+            f"over a head dim divisible by {NVFP4_SCALE_BLOCK}; got block "
+            f"{block}, head dim {head_dim}"
+        )
+    raw = getattr(config, "engram_quant_global_scale", None)
+    if isinstance(raw, dict):
+        by_layer = {int(key): value for key, value in raw.items()}
+        missing = [layer for layer in layer_ids if layer not in by_layer]
+        if missing:
+            raise ValueError(
+                f"engram_quant_global_scale has no entry for engram layers {missing}"
+            )
+        scales = [by_layer[layer] for layer in layer_ids]
+    elif isinstance(raw, (list, tuple)) and len(raw) == len(layer_ids):
+        scales = list(raw)
+    else:
+        raise ValueError(
+            "NVFP4 engram tables need engram_quant_global_scale as a "
+            "{layer_id: scale} dict or a list aligned with engram_layer_ids; "
+            f"got {raw!r}"
+        )
+    scales = [float(scale) for scale in scales]
+    if not all(math.isfinite(scale) and scale > 0 for scale in scales):
+        raise ValueError(
+            f"engram_quant_global_scale must be finite and positive: {scales}"
+        )
+    return ENGRAM_QUANT_NVFP4, block, tuple(scales)
+
 
