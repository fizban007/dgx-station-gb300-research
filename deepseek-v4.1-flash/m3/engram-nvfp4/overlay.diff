+def _engram_nvfp4_head_shard_weight_loader(
+    param: torch.nn.Parameter, loaded_weight: torch.Tensor
+) -> None:
+    """Load this rank's NVFP4 rows as raw bytes.
+
+    Packed values must arrive as U8 and scales as F8_E4M3 (or their raw U8
+    bytes); anything else is an FP8-format table under an NVFP4 config, which
+    a dtype-converting copy would silently corrupt.
+    """
+    if param.dtype == torch.uint8:
+        accepted: tuple[torch.dtype, ...] = (torch.uint8,)
+    else:
+        assert param.dtype == torch.float8_e4m3fn, param.dtype
+        accepted = (torch.float8_e4m3fn, torch.uint8)
+    if loaded_weight.dtype not in accepted:
+        raise ValueError(
+            f"NVFP4 engram {tuple(param.shape)} {param.dtype} parameter cannot load "
+            f"a {loaded_weight.dtype} checkpoint tensor; does config.json "
+            "engram_quant match the engram shards?"
+        )
+    if loaded_weight.dtype != param.dtype:
+        loaded_weight = loaded_weight.view(param.dtype)
+    _engram_head_shard_weight_loader(param, loaded_weight)
+
