+        "GRID",
+    ]
+)
+def _engram_nvfp4_lookup_kernel(
+    weight,
+    scales,
+    ids,
+    out,
+    global_scale,
+    vocab_start,
+    vocab_end,
+    num_rows,
+    ids_stride_t,
+    ids_stride_h,
+    HEAD_START: tl.constexpr,
+    LOCAL_HEADS: tl.constexpr,
+    TOTAL_HEADS: tl.constexpr,
+    DIM: tl.constexpr,
+    QUANT_BLOCK: tl.constexpr,
+    BLOCK_R: tl.constexpr,
+    GRID,
+):
+    """Gather NVFP4 rows, decode e2m1 * e4m3 scale * global scale, write bf16.
+
+    Same row walk, ownership masking and output layout as
+    `_engram_lookup_kernel`; `weight`/`scales` may address pinned host memory
+    through UVA. Rows are DIM // 2 packed bytes (low nibble = even element)
+    and DIM // QUANT_BLOCK e4m3 scales.
+    """
+    HALF: tl.constexpr = DIM // 2
+    NUM_BLOCKS: tl.constexpr = DIM // QUANT_BLOCK
+    byte_cols = tl.arange(0, HALF)
+    block_cols = tl.arange(0, NUM_BLOCKS)
+    cols = tl.arange(0, DIM)
+    global_scale = global_scale.to(tl.float32)
+    for base in tl.range(tl.program_id(0) * BLOCK_R, num_rows, GRID * BLOCK_R):
+        rows = base + tl.arange(0, BLOCK_R)
+        valid = rows < num_rows
+        head = HEAD_START + rows % LOCAL_HEADS
+        token = (rows // LOCAL_HEADS).to(tl.int64)
+        index = tl.load(
+            ids + token * ids_stride_t + head * ids_stride_h,
+            mask=valid & (head < TOTAL_HEADS),
+            other=-1,
+        ).to(tl.int64)
+        owned = valid & (head < TOTAL_HEADS)
+        owned &= (index >= vocab_start) & (index < vocab_end)
+        local = tl.where(owned, index - vocab_start, 0)
+        packed = tl.load(
+            weight + local[:, None] * HALF + byte_cols[None, :],
+            mask=owned[:, None],
+            other=0,
+        )
+        scale = tl.load(
+            scales + local[:, None] * NUM_BLOCKS + block_cols[None, :],
+            mask=owned[:, None],
+            other=0.0,
+        ).to(tl.float32)
+        values = tl.interleave(
+            _e2m1_inline(packed & 0x0F), _e2m1_inline((packed >> 4) & 0x0F)
+        )
+        # e2m1 * e4m3 is exact in fp32, so the global scale rounds once.
+        values = tl.reshape(values, (BLOCK_R, NUM_BLOCKS, QUANT_BLOCK))
+        values = values * scale[:, :, None] * global_scale
+        tl.store(
+            out + rows[:, None] * DIM + cols[None, :],
+            tl.reshape(values, (BLOCK_R, DIM)).to(tl.bfloat16),
+            mask=valid[:, None],
+        )
+
